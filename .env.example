# Copy to .env and edit. Never commit .env.
# Shared secret: the dashboard sends it in the X-API-Key header, the API checks it.
API_KEY=change-me-to-a-long-random-string
# Postgres connection (docker-compose overrides this for the api container).
DATABASE_URL=postgresql://mosje:mosje@localhost:5432/mosje
# Dashboard -> API address (docker-compose overrides this for the dashboard container).
API_BASE_URL=http://localhost:8000
# Load synthetic data and run the pipeline automatically on first start.
AUTO_SEED=true
AUTO_RUN_PIPELINE=true
# Optional
LOG_LEVEL=INFO
KEEP_OLD_RESULTS=false        # true = keep results of earlier runs (DB grows ~60 MB per run)
PIPELINE_SENSITIVITY=false    # true = also run the non-spec sensitivity analysis (slower)
